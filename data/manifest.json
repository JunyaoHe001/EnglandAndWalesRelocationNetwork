{
  "schema_version": "2.0.0",
  "pipeline_version": "2026-08-19-v3",
  "title": "Age-Specific Internal Migration Networks in England and Wales",
  "short_title": "England & Wales Migration Networks",
  "period_definition": "Year ending June",
  "geography": "ONS Local Authority Districts, December 2023",
