      "max_age_exclusive": 20
    },
    {
      "key": "young_adults_20_40",
      "label": "Young adults (20–40)",
      "label_zh": "青年人（20–40）",
      "min_age": 20,
      "max_age_exclusive": 40
    },
    {
      "key": "prime_working_age_30_50",
      "label": "Prime working age (30–50)",
      "label_zh": "核心劳动年龄（30–50）",
      "min_age": 30,
      "max_age_exclusive": 50
    },
    {
      "key": "older_working_age_50_65",
      "label": "Older working age (50–65)",
      "label_zh": "较高劳动年龄（50–65）",
      "min_age": 50,
      "max_age_exclusive": 65
    },
    {
      "key": "elderly_65_plus",
      "label": "Elderly (65+)",
      "label_zh": "老年人（65+）",
      "min_age": 65,
      "max_age_exclusive": null
    }
  ],
  "age_group_note": "Ranges are half-open at the upper bound. The 20–40 and 30–50 layers overlap at ages 30–39.",
  "geography_count": 318,
  "layer_count": 70,
  "files": {
    "map": "data/map.json.gz",
    "network_summary": "data/network_summary.json",
    "year_template": "data/years/{year}.json.gz",
    "timeseries_template": "data/timeseries/{age_group}.json.gz"
  },
  "schemas": {
    "region_fields": [
      "index",
      "id",
      "name",
      "x",
      "y",
      "path",
      "nation"
    ],
    "node_fields": [
      "index",
      "inflow",
      "outflow",
      "total_flow",
      "net_flow",
      "in_degree",
      "out_degree",
      "balance_index",
      "mean_in_distance_km",
      "mean_out_distance_km",
      "activity_share"
    ],
    "edge_fields": [
      "source_index",
      "target_index",
      "flow",
      "distance_km",
      "rank",
      "cumulative_flow_share"
    ]
  },
  "front_end_defaults": {
    "visible_edges": 500,
    "maximum_exported_edges": 4000,
    "node_size_metric": "total_flow",
    "node_colour_metric": "balance_index",
    "edge_width_metric": "flow",
    "show_edges": true,
    "show_nodes": true,
    "show_labels": false
  },
  "scales": {
